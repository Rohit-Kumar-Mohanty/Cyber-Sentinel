def create_card(parent, title_text, value_text, color):
    card = ctk.CTkFrame(
        parent,
        fg_color=PANEL,
        corner_radius=10
    )
    card.pack(side="left", fill="both", expand=True, padx=5)

    ctk.CTkLabel(
        card,
        text=title_text,
        font=("Arial", 12),
        text_color=GREY
    ).pack(pady=(15, 3))

    ctk.CTkLabel(
        card,
        text=value_text,
        font=("Arial", 25, "bold"),
        text_color=color
    ).pack(pady=(0, 15))

    return card


