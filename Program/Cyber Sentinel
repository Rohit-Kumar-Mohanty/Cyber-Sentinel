def add_log(message, color=WHITE):
    log_box.configure(state="normal")
    log_box.insert("end", f"  {message}\n", "normal")
    log_box.tag_config("normal", foreground=color)
    log_box.configure(state="disabled")
    log_box.see("end")


def clear_log():
    log_box.configure(state="normal")
    log_box.delete("1.0", "end")
    log_box.configure(state="disabled")


def update_status(text, color=CYAN):
